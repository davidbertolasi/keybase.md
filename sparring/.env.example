# Copiá este archivo a .env (o cargá las variables en tu plataforma de deploy). Nunca subas .env a git.

# Clave de la API de Claude (console.anthropic.com). Obligatoria salvo que uses SPARRING_PROVIDER=mock.
ANTHROPIC_API_KEY=sk-ant-...

# Token de acceso a /api. Cuando la app está en internet, sin esto cualquiera con la URL gasta tu clave.
# Se entra una vez por URL: https://tu-app/#token=ESTE-VALOR (queda guardado en ese navegador).
# SPARRING_ACCESS_TOKEN=elegí-una-frase-larga-y-privada

# Proveedor: claude (default) o mock (respuestas simuladas, sin gastar API; útil para desarrollar la interfaz).
# SPARRING_PROVIDER=mock

# Modelos y esfuerzo. 'quick' = turnos de escena, reflejo y balances; 'default' = "respondé por mí" con capturas.
# SPARRING_MODEL_DEFAULT=claude-opus-5-5
# SPARRING_MODEL_QUICK=claude-opus-5-5
# SPARRING_EFFORT_QUICK=low
# SPARRING_EFFORT_DEFAULT=medium
# SPARRING_MAX_TOKENS=4096

# Pedidos por minuto por IP antes de responder 429.
# SPARRING_RATE_PER_MIN=30
# Si corrés detrás de un proxy (Railway, Render, Fly, Cloud Run): 1, para que el límite use la IP real.
# SPARRING_TRUST_PROXY=1
# Loguear tokens usados por pedido (para medir costo real).
# SPARRING_LOG_USAGE=1
# PORT=3000
